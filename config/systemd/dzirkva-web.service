[Unit]
Description=dzirkva web (127.0.0.1:8000) + MCP (127.0.0.1:8001/mcp)
After=network-online.target

[Service]
User=luka
WorkingDirectory=/home/luka/dzirkva
Environment=HF_HUB_OFFLINE=1
# --extra mcp: the MCP listener (MCP_PORT in .env) runs in this process (MCP.md)
ExecStart=/home/luka/.local/bin/uv run --frozen --extra mcp python -m dzirkva.web
Restart=always
RestartSec=5
# The server has 7 GB and no screen: the web app dies before SSH does
MemoryMax=5800M
Nice=5

[Install]
WantedBy=multi-user.target
